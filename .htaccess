
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/surefixco/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/surefixco/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# Pages are real .php files now, so PHP executes natively on every host.
# (No AddType/AddHandler tricks needed for running PHP inside .html.)

Options -MultiViews
RewriteEngine On

# Custom 404 page (served by 404-page.php, keeps a real 404 status).
ErrorDocument 404 /404-page.php

# Force HTTPS + non-www  (LIVE ONLY - skipped on localhost / 127.0.0.1 for testing)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://surefix.co.in%{REQUEST_URI} [R=301,L]

# 1. Redirect /index.html or /index.php -> /   (LIVE ONLY; old indexed URLs)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(html|php)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Redirect /page.html or /page.php -> /page  (clean URLs; LIVE ONLY, GET only)
#    GET-only so AJAX form POSTs to the *.php handlers are never redirected.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(html|php)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Internally serve /page as /page.php
#    (no RewriteBase, so it works both at web root AND in a /surefix/ subfolder)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]